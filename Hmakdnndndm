      height: 200%;
      pointer-events: none;
      z-index: 40;
      background-image: url("data:image/svg+xml,%3Csvg width='420' height='240' xmlns='http://www.w3.org/2000/svg'%3E%3Cg transform='rotate(-24 210 120)'%3E%3Ctext x='50%25' y='42%25' dominant-baseline='middle' text-anchor='middle' fill='%23f472b6' fill-opacity='0.04' font-family='Georgia, serif' font-weight='bold' font-size='20' letter-spacing='4'%3ELEAH • PERSONAL SUITE%3C/text%3E%3Ctext x='50%25' y='60%25' dominant-baseline='middle' text-anchor='middle' fill='%23f472b6' fill-opacity='0.03' font-family='sans-serif' font-weight='700' font-size='12' letter-spacing='3'%3EEXECUTIVE FOCUS%3C/text%3E%3C/g%3E%3C/svg%3E");
      background-repeat: repeat;
    }
    @keyframes floatUpAndFade {
      0% { opacity: 0; transform: translateY(10px) scale(0.8); }
      15% { opacity: 1; transform: translateY(-15px) scale(1.1); }
      75% { opacity: 1; transform: translateY(-35px) scale(1); }
      100% { opacity: 0; transform: translateY(-50px) scale(0.9); }
    }
    .animate-float-xp {
      animation: floatUpAndFade 2.5s ease-out forwards;
    }
