  <script>
    function safeGetStorage(key, defaultVal) {
      try { return localStorage.getItem(key) || defaultVal; } catch (e) { return defaultVal; }
    }
    function safeSetStorage(key, val) {
      try { localStorage.setItem(key, val); } catch (e) {}
    }

    function showActionToast(msg) {
      const toast = document.getElementById('actionToast');
      document.getElementById('actionToastMsg').textContent = msg;
      toast.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => toast.classList.add('hidden'), 3200);
    }

    let xp = parseInt(safeGetStorage('rc_xp_cs', '0'), 10);
    let logs = JSON.parse(safeGetStorage('rc_logs_cs', '[]'));
    let currentPaper = 'Corporate Accounting';
    let currentActivity = 'Reading';
    let currentActivityXp = 20;
    let reportPeriod = 'week';

    function updateStatsUI() {
      document.getElementById('stickyXpText').textContent = `${xp} XP`;
      safeSetStorage('rc_xp_cs', xp);
      safeSetStorage('rc_logs_cs', JSON.stringify(logs));
    }

    function playChime(freq = 528, duration = 0.15) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = ctx.createOscillator(); const gain = ctx.createGain();
        osc.type = 'sine'; osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(); osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    }

    function spawnFloatingXP(amount, textPrefix = '🎉 +') {
      const badge = document.getElementById('stickyXpBadge');
      const rect = badge.getBoundingClientRect();
      const floater = document.createElement('div');
      floater.innerHTML = `${textPrefix}${amount} XP`;
      floater.className = 'fixed font-extrabold text-rose-500 text-lg z-[100] pointer-events-none drop-shadow-md animate-float-xp';
      floater.style.left = (rect.left + rect.width / 2 - 30) + 'px';
      floater.style.top = (rect.top - 10) + 'px';
      document.body.appendChild(floater);
      setTimeout(() => floater.remove(), 2500);

      badge.classList.add('scale-110', 'bg-rose-50', 'border-rose-300');
      setTimeout(() => badge.classList.remove('scale-110', 'bg-rose-50', 'border-rose-300'), 300);
    }

    function addLogEntry(paper, activity, xpVal) {
      const entry = {
        timestamp: new Date().toISOString(),
        paper: paper,
        activity: activity,
        xp: xpVal
      };
      logs.unshift(entry);
      updateStatsUI();
    }

    function logHabitXP(habitName, amount, msg) {
      xp += amount;
      addLogEntry(habitName, 'Habit / Prep', amount);
      playChime(640, 0.15);
      showActionToast(`✨ ${msg}! +${amount} XP`);
      spawnFloatingXP(amount);
    }

    function logStartStudyingXP() {
      xp += 50;
      addLogEntry('Study Session', 'Habit / Prep', 50);
      playChime(720, 0.2);
      showActionToast('🚀 Started studying! +50 XP');
      spawnFloatingXP(50);
    }

    function selectPaper(paper) {
      currentPaper = paper;
      document.getElementById('customPaperInput').value = '';
      ['Corporate Accounting', 'Company Law', 'Financial Management', 'JIGL'].forEach(p => {
        const btn = document.getElementById('paper-' + p);
        if (p === paper) {
          btn.className = 'paper-btn bg-rose-50 text-slate-700 font-bold text-xs p-3 rounded-xl border-2 border-rose-300 transition text-center truncate';
        } else {
          btn.className = 'paper-btn bg-white text-slate-600 hover:bg-slate-50 font-bold text-xs p-3 rounded-xl border border-slate-200 transition text-center truncate';
        }
      });
      updateActiveTargetDisplay();
    }

    function selectCustomPaper(val) {
      if (val.trim() !== '') {
        currentPaper = val;
        ['Corporate Accounting', 'Company Law', 'Financial Management', 'JIGL'].forEach(p => {
          document.getElementById('paper-' + p).className = 'paper-btn bg-white text-slate-600 hover:bg-slate-50 font-bold text-xs p-3 rounded-xl border border-slate-200 transition text-center truncate';
        });
        updateActiveTargetDisplay();
      }
    }

    function selectActivity(activity, xpValue) {
      currentActivity = activity;
      currentActivityXp = xpValue;
      
      const activities = ['Reading', 'Lecture', 'Problem Solving', 'Notes', 'Testing', 'Revision', 'Custom Study Sprint'];
      activities.forEach(a => {
        const btn = document.getElementById('act-' + a);
        if (a === activity) {
          btn.className = `act-btn bg-white text-slate-700 font-bold text-xs p-4 rounded-2xl border-2 border-rose-300 shadow-sm transition text-left flex flex-col justify-between ${a === 'Custom Study Sprint' ? 'col-span-2' : ''}`;
        } else {
          btn.className = `act-btn bg-white text-slate-700 hover:bg-slate-50 font-bold text-xs p-4 rounded-2xl border border-slate-200 transition text-left flex flex-col justify-between opacity-90 hover:opacity-100 ${a === 'Custom Study Sprint' ? 'col-span-2' : ''}`;
        }
      });

      document.getElementById('completeBtnText').textContent = `✅ Complete Sprint (+${xpValue} XP)`;
      updateActiveTargetDisplay();
    }

    function updateActiveTargetDisplay() {
      document.getElementById('activeTargetDisplay').textContent = `${currentPaper} — ${currentActivity} (15 Mins)`;
    }

    function completeActiveSprint() {
      xp += currentActivityXp;
      addLogEntry(currentPaper, currentActivity, currentActivityXp);
      playChime(784, 0.25);
      showActionToast(`✨ Completed ${currentActivity} session! +${currentActivityXp} XP`);
      spawnFloatingXP(currentActivityXp);
    }

    function switchTab(tab) {
      const trackerTab = document.getElementById('tabTrackerContent');
      const reportTab = document.getElementById('tabReportContent');
      const trackerBtn = document.getElementById('tabTrackerBtn');
      const reportBtn = document.getElementById('tabReportBtn');

      if (tab === 'tracker') {
        trackerTab.classList.remove('hidden');
        reportTab.classList.add('hidden');
        trackerBtn.className = 'flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition bg-rose-400 text-white shadow-sm';
        reportBtn.className = 'flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition text-slate-600 hover:bg-slate-50';
      } else {
        trackerTab.classList.add('hidden');
        reportTab.classList.remove('hidden');
        reportBtn.className = 'flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition bg-rose-400 text-white shadow-sm';
        trackerBtn.className = 'flex-1 py-2.5 px-4 rounded-xl text-xs font-bold transition text-slate-600 hover:bg-slate-50';
        renderReport();
      }
    }

    function setReportPeriod(period) {
      reportPeriod = period;
      ['week', 'month', 'custom'].forEach(p => {
        const btn = document.getElementById('period' + p.charAt(0).toUpperCase() + p.slice(1));
        if (p === period) {
          btn.className = 'px-3 py-1.5 rounded-lg transition bg-white text-slate-800 shadow-sm';
        } else {
          btn.className = 'px-3 py-1.5 rounded-lg transition text-slate-600 hover:text-slate-800';
        }
      });
      const customBox = document.getElementById('customDateBox');
      if (period === 'custom') {
        customBox.classList.remove('hidden');
      } else {
        customBox.classList.add('hidden');
      }
      renderReport();
    }

    function renderReport() {
      const filterPaper = document.getElementById('filterPaper').value;
      const filterActivity = document.getElementById('filterActivity').value;
      const startDateVal = document.getElementById('customStartDate').value;
      const endDateVal = document.getElementById('customEndDate').value;

      const now = new Date();
      let filtered = logs.filter(item => {
        const itemDate = new Date(item.timestamp);
        
        // Period filter
        if (reportPeriod === 'week') {
          const oneWeekAgo = new Date();
          oneWeekAgo.setDate(now.getDate() - 7);
          if (itemDate < oneWeekAgo) return false;
        } else if (reportPeriod === 'month') {
          if (itemDate.getMonth() !== now.getMonth() || itemDate.getFullYear() !== now.getFullYear()) return false;
        } else if (reportPeriod === 'custom' && startDateVal && endDateVal) {
          const start = new Date(startDateVal);
          const end = new Date(endDateVal);
          end.setHours(23, 59, 59);
          if (itemDate < start || itemDate > end) return false;
        }

        // Subject Paper filter
        if (filterPaper !== 'ALL' && item.paper !== filterPaper) return false;

        // Activity filter
        if (filterActivity !== 'ALL') {
          if (filterActivity === 'Habit / Prep' && item.activity !== 'Habit / Prep') return false;
          if (filterActivity !== 'Habit / Prep' && item.activity !== filterActivity) return false;
        }

        return true;
      });

      // Calculate Summary Metrics
      const totalXp = filtered.reduce((acc, curr) => acc + curr.xp, 0);
      const sprints = filtered.filter(item => item.activity !== 'Habit / Prep');
      const habits = filtered.filter(item => item.activity === 'Habit / Prep');
      const totalHours = (sprints.length * 15) / 60; // Each sprint is 15 mins

      document.getElementById('repTotalXp').textContent = `${totalXp} XP`;
      document.getElementById('repTotalSprints').textContent = sprints.length;
      document.getElementById('repTotalHours').textContent = `${totalHours.toFixed(1)}h`;
      document.getElementById('repTotalHabits').textContent = habits.length;

      // Render Trends Chart (Subject Breakdown)
      const chartContainer = document.getElementById('trendsChartContainer');
      chartContainer.innerHTML = '';

      const paperXpMap = {};
      filtered.forEach(item => {
        const p = item.paper || 'Other';
        paperXpMap[p] = (paperXpMap[p] || 0) + item.xp;
      });

      const maxPaperXp = Math.max(...Object.values(paperXpMap), 1);

      if (Object.keys(paperXpMap).length === 0) {
        chartContainer.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">No data logged for this period/filter.</p>';
      } else {
        for (const [paper, xpVal] of Object.entries(paperXpMap)) {
          const pct = Math.round((xpVal / maxPaperXp) * 100);
          const row = document.createElement('div');
          row.className = 'space-y-1';
          row.innerHTML = `
            <div class="flex justify-between text-xs font-bold text-slate-700">
              <span>${paper}</span>
              <span class="text-rose-500">${xpVal} XP</span>
            </div>
            <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
              <div class="bg-rose-400 h-full rounded-full transition-all duration-500" style="width: ${pct}%"></div>
            </div>
          `;
          chartContainer.appendChild(row);
        }
      }

      // Render Table Logs
      const tbody = document.getElementById('logTableBody');
      tbody.innerHTML = '';
      if (filtered.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-slate-400">No activity logs found.</td></tr>';
      } else {
        filtered.forEach(item => {
          const d = new Date(item.timestamp);
          const dateStr = d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-50 transition';
          tr.innerHTML = `
            <td class="p-2.5 text-slate-500">${dateStr}</td>
            <td class="p-2.5 font-bold text-slate-800">${item.paper}</td>
            <td class="p-2.5"><span class="bg-rose-50 text-rose-600 px-2 py-0.5 rounded-md font-semibold text-[11px]">${item.activity}</span></td>
            <td class="p-2.5 text-right font-extrabold text-rose-500">+${item.xp} XP</td>
          `;
          tbody.appendChild(tr);
        });
      }
    }

    function clearLogs() {
      if (confirm('Are you sure you want to clear your study history logs?')) {
        logs = [];
        updateStatsUI();
        renderReport();
        showActionToast('🗑️ History logs cleared.');
      }
    }

    updateStatsUI();
  </script>
</body>
</html>
